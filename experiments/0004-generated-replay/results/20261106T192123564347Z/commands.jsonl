{"name": "s4-q4-release-orders", "argv": ["env", "MIX_ENV=prod", "mix", "release", "orders", "--overwrite"], "cwd": "/var/folders/0y/gcbfrs51401ghzf3hxdm3l5c0000gp/T/beaml-0004-s4-q4-9argp3f8/experiments/0002-http-correlation", "exit_code": 0}
{"name": "s4-q4-eval-E15b-q4-0", "argv": ["/var/folders/0y/gcbfrs51401ghzf3hxdm3l5c0000gp/T/beaml-0004-s4-q4-9argp3f8/experiments/0002-http-correlation/_build/prod/rel/orders/bin/orders", "eval", "\ninput = :json.decode(File.read!(System.fetch_env!(\"REPLAY_INPUT\")))\n:persistent_term.put(:probe_count, :atomics.new(1, []))\nif input[\"observe\"] == true do\n  {:ok, _} = Application.ensure_all_started(:opentelemetry)\n  {:ok, _} = ProbeSupport.Capture.start_link(nil)\nend\nwatched = [{OrdersApi.Router, :call, 2}, {OrdersBeamlSpike, :payments_authorize, 1}, {:gen_tcp, :connect, 4}, {OrdersBeamlSpike, :prepare, 1}, {:json, :decode, 1}, {OrdersBeamlSpike, :finish, 1}, {ProbeSupport, :valid_payment!, 2}, {OrdersBeamlSpike, :payments_charge, 1}, {OrdersBeamlSpike, :nsjxiftp_opodhyvc, 1}, {OrdersBeamlSpike, :nrxvtkoj_oqlmnilc, 1}]\nunwatched = for {m, _, _} = mfa <- watched, Code.ensure_loaded?(m) == false or :erlang.trace_pattern(mfa, true, [:call_count]) != 1, do: inspect(mfa)\norder = input[\"order\"]\nresult =\n  try do\n    case input[\"mode\"] do\n      \"place\" -> OrdersBeamlSpike.place(order)\n      \"replay\" ->\n        case OrdersBeamlSpike.Replay.run(ProbeSupport.valid_order!(order), input[\"trace_id\"], input[\"responses\"]) do\n          {:ok, p} -> {:ok, ProbeSupport.valid_payment!(p, order)}\n          other -> other\n        end\n      # Slice 2: the decoded value as it is. The host check `valid_payment!/2` knows only `status`.\n      \"replay_plain\" -> OrdersBeamlSpike.Replay.run(ProbeSupport.valid_order!(order), input[\"trace_id\"], input[\"responses\"])\n    end\n  rescue\n    error -> {:raised, inspect(error.__struct__)}\n  end\nif input[\"observe\"] == true, do: :otel_tracer_provider.force_flush()\nreport = case result do\n  {:ok, payment} -> %{ok: payment}\n  {:error, reason} when is_atom(reason) -> %{error: Atom.to_string(reason)}\n  {:error, reason} -> %{error: inspect(reason)}\n  {:raised, name} -> %{raised: name}\n  other -> %{unexpected: inspect(other)}\nend\ncalls = Map.new(watched, fn {m, f, a} = mfa ->\n  count = case :erlang.trace_info(mfa, :call_count) do {:call_count, n} when is_integer(n) -> n; _ -> nil end\n  {\"#{inspect(m)}.#{f}/#{a}\", count} end)\nIO.puts(\"REPLAY \" <> IO.iodata_to_binary(:json.encode(%{\n  result: report, transport: ProbeSupport.count(), calls: calls, unwatched: unwatched,\n  artifact: ProbeSupport.beam_hash(OrdersBeamlSpike)})))\n"], "cwd": "/Users/lennart/Projects/beaml", "exit_code": 0}
