// Case D1, D8, D10: DRIFT R with `add` (README, Cases (slice 3)).
interface Order { order_id: String }
interface Payment { order_id: String status: String reference: String }
migrate Payment 1 -> 2 { add reference: String = "pre-v2" }
interface PaymentError { reason: String }

effect payments.authorize Order -> Payment ! PaymentError = http.post("payments/authorize")

fn prepare Order { order_id } -> Order = Order { order_id: order_id + "" }
fn finish Payment { order_id, status, reference } -> Payment = Payment { order_id: order_id + "", status: status, reference: reference }

fn place order: Order -> Payment ! PaymentError =
  order
  |> prepare
  |> payments.authorize
  |> finish
