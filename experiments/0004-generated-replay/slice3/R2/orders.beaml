// Case D2b: two added fields without a MIGRATE CHAIN.
interface Order { order_id: String }
interface Payment { order_id: String status: String reference: String channel: String }
interface PaymentError { reason: String }

effect payments.authorize Order -> Payment ! PaymentError = http.post("payments/authorize")

fn prepare Order { order_id } -> Order = Order { order_id: order_id + "" }
fn finish Payment { order_id, status, reference, channel } -> Payment = Payment { order_id: order_id + "", status: status, reference: reference, channel: channel }

fn place order: Order -> Payment ! PaymentError =
  order
  |> prepare
  |> payments.authorize
  |> finish
