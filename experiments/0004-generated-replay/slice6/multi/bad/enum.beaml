// Slice 6e (D6B-203): the stem enum gives the module Enum, which the generated code calls.
type NoCurrency {}
type Amount { value: String currency: String }
fn Amount value: String, currency: String -> Amount ! NoCurrency
fn Amount _,     ""       -> Amount ! NoCurrency = NoCurrency {}
fn Amount value, currency -> Amount ! NoCurrency = Amount { value: value, currency: currency }

enum Channel { Web = "web"  App = "app-channel"  Unknown(String) }

type PlaceOrder { order_id: String amount: Amount channel: Channel }

effect ui.echo PlaceOrder -> PlaceOrder = ui.event("echo") |> echo

fn echo p: PlaceOrder -> PlaceOrder = p
