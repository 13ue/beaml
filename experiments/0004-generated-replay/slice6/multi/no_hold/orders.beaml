// Slice 6e (N8, N9): the multi fixture without stock.reserve, ui.hold and hold (D6B-210: stem orders).
type NoCurrency {}
type Amount { value: String currency: String }
fn Amount value: String, currency: String -> Amount ! NoCurrency
fn Amount _,     ""       -> Amount ! NoCurrency = NoCurrency {}
fn Amount value, currency -> Amount ! NoCurrency = Amount { value: value, currency: currency }

enum Channel { Web = "web"  App = "app-channel"  Unknown(String) }

type PlaceOrder { order_id: String amount: Amount channel: Channel }
type Order { order_id: String }
type Payment { order_id: String status: String }
type PaymentError { reason: String }
type Hold { order_id: String amount: Amount }
type StockError { reason: String }

// Leaves the module.
effect payments.authorize Order -> Payment ! PaymentError = http.post("payments/authorize")

// Enters the module.
effect ui.place PlaceOrder -> Payment ! PaymentError = ui.event("place") |> place

fn to_order PlaceOrder { order_id, amount, channel } -> Order = Order { order_id: order_id }

fn place p: PlaceOrder -> Payment ! PaymentError =
  p
  |> to_order
  |> payments.authorize
