// DL-116 (O2): a redacted field in a TYPE below a TYPE with a constructor, in an EFFECT output.
type Inner { s: redacted String }
type Amount { inner: Inner }
fn Amount v: String -> Amount = Amount { inner: Inner { s: v } }
type Order { order_id: String }
type Payment { order_id: String status: String amount: Amount }
type PaymentError { reason: String }
effect payments.authorize Order -> Payment ! PaymentError = http.post("payments/authorize")
fn place order: Order -> Payment ! PaymentError = order |> payments.authorize
