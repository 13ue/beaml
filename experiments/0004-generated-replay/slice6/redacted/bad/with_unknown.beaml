// D6B-65: with names a field that the EFFECT input TYPE does not have.
type Order { order_id: String card_holder: redacted String }
type Payment { order_id: String status: String }
type PaymentError { reason: String }
effect payments.authorize Order -> Payment ! PaymentError = http.post("payments/authorize") with holder
fn place order: Order -> Payment ! PaymentError = order |> payments.authorize
