// EXPERIMENT 0004 fmt layout (DL-148): TYPE and ENUM bodies, one clause table per block.
type Empty {  }
type Note {   text: String   }
type Amount { value: String currency: String }
type Order {
  order_id: String
    amount: Amount
}
type One {
  id: String
}
type Pair { a: String, b: String }
type Commented {
    a: String // a comment inside a body keeps the body as written
  b: String
}
enum Channel { Web = "web"  App = "app"  Unknown(String) }
enum Single { Only }
type BadAmount {}
type StoreError { reason: String }

// One table: a signature line, constructor clauses, EFFECT lines, an ENTRY LINE and fn clauses.
fn Amount value: String, currency: String -> Amount ! BadAmount
fn Amount _, "" -> Amount ! BadAmount = BadAmount {}
fn Amount value, currency -> Amount ! BadAmount = Amount { value: value, currency: currency }
effect orders.save Order -> Order ! StoreError = db.put("records")
effect payments.check Note -> Note ! StoreError = http.post("payments/check")
effect ui.save Order   ->   Order ! StoreError = ui.event("save") |> save
fn check_note n: Note -> Note ! StoreError = n |> payments.check
fn label c: Channel -> String = "a -> b = c"
// A comment line ends the block:   x  ->   y
fn save o: Order -> Order ! StoreError = o |> orders.save
fn keep n: Note -> Note = n
fn tidy Only -> String =
  "a"
fn tidy_one x: String   ->  String = x
