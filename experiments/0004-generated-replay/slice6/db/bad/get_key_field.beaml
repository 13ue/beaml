// Slice 6 db reject (N12): the key field is a String field of the ROW TYPE (QDB-1).
type Order { order_id: String label: String }
type ByName { name: String }
type StoreError { reason: String }
effect orders.load ByName -> Order ! StoreError = db.get("records")

fn load k: ByName -> Order ! StoreError = k |> orders.load
