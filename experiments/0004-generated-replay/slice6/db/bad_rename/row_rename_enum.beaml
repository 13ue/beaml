// Slice 6 db (N12): a rename onto an enum field builds (DL-166); the path keeps its old name (PB-06).
enum Channel {
  Web = "web"
  App = "app"
  Unknown(String)
}
type Order {
  order_id: String
  channel: Channel
}
migrate Order v1 -> v2 { rename via -> channel }
type StoreError { reason: String }
effect orders.save Order -> Order ! StoreError = db.put("records")

fn save o: Order -> Order ! StoreError = o |> orders.save
