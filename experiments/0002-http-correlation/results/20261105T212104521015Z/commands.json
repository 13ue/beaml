[
  {
    "name": "elixir-version",
    "args": [
      "elixir",
      "--version"
    ]
  },
  {
    "name": "python-version",
    "args": [
      "/Applications/Xcode.app/Contents/Developer/usr/bin/python3",
      "--version"
    ]
  },
  {
    "name": "cargo-version",
    "args": [
      "cargo",
      "--version"
    ]
  },
  {
    "name": "rust-version",
    "args": [
      "rustc",
      "--version"
    ]
  },
  {
    "name": "generate-orders",
    "args": [
      "cargo",
      "run",
      "--quiet",
      "--manifest-path",
      "/Users/lennart/Projects/beaml/experiments/0001-syntax-to-beam/Cargo.toml",
      "--",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/apps/orders_api/priv/orders.beaml"
    ]
  },
  {
    "name": "generate-payments",
    "args": [
      "cargo",
      "run",
      "--quiet",
      "--manifest-path",
      "/Users/lennart/Projects/beaml/experiments/0001-syntax-to-beam/Cargo.toml",
      "--",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/apps/payments_api/priv/payments.beaml"
    ]
  },
  {
    "name": "dependencies",
    "args": [
      "mix",
      "deps.get"
    ]
  },
  {
    "name": "format-generated",
    "args": [
      "mix",
      "format",
      "apps/orders_api/lib/generated.ex",
      "apps/payments_api/lib/generated.ex"
    ]
  },
  {
    "name": "format",
    "args": [
      "mix",
      "format",
      "--check-formatted"
    ]
  },
  {
    "name": "release-orders",
    "args": [
      "mix",
      "release",
      "orders",
      "--overwrite"
    ]
  },
  {
    "name": "release-payments",
    "args": [
      "mix",
      "release",
      "payments",
      "--overwrite"
    ]
  },
  {
    "name": "python-tests",
    "args": [
      "/Applications/Xcode.app/Contents/Developer/usr/bin/python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests"
    ]
  },
  {
    "name": "fixture-tests-orders",
    "args": [
      "elixir",
      "-pa",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/_build/prod/lib/probe_support/ebin",
      "-pa",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/_build/prod/lib/orders_api/ebin",
      "tests/fixture_test.exs"
    ]
  },
  {
    "name": "fixture-tests-payments",
    "args": [
      "elixir",
      "-pa",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/_build/prod/lib/probe_support/ebin",
      "-pa",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/_build/prod/lib/payments_api/ebin",
      "tests/fixture_test.exs"
    ]
  },
  {
    "name": "capture-tests",
    "args": [
      "elixir",
      "-pa",
      "/Users/lennart/Projects/beaml/experiments/0002-http-correlation/_build/prod/lib/probe_support/ebin",
      "tests/capture_test.exs"
    ]
  }
]
