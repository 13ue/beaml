{application,proto,
             [{modules,['Elixir.BeamlDb','Elixir.Mix.Tasks.Beaml.Stored',
                        'Elixir.Orders','Elixir.Orders.Amount',
                        'Elixir.Orders.BadAmount',
                        'Elixir.Orders.BeamlFailure','Elixir.Orders.Rejected',
                        'Elixir.Orders.Replay','Elixir.Orders.StoreError',
                        'Elixir.Proto','Elixir.Proto.Application',
                        'Elixir.Proto.DataCase','Elixir.Proto.Prototype',
                        'Elixir.Proto.Repo','Elixir.Proto.UseCaseFormatter',
                        'Elixir.ProtoWeb','Elixir.ProtoWeb.ActionLog',
                        'Elixir.ProtoWeb.ConnCase',
                        'Elixir.ProtoWeb.CoreComponents',
                        'Elixir.ProtoWeb.Endpoint',
                        'Elixir.ProtoWeb.ErrorHTML',
                        'Elixir.ProtoWeb.ErrorJSON','Elixir.ProtoWeb.Layouts',
                        'Elixir.ProtoWeb.NotesLive',
                        'Elixir.ProtoWeb.OrderFormLive',
                        'Elixir.ProtoWeb.OrderListLive',
                        'Elixir.ProtoWeb.PageController',
                        'Elixir.ProtoWeb.PageHTML','Elixir.ProtoWeb.Router',
                        'Elixir.ProtoWeb.Telemetry']},
              {compile_env,[{proto,['Elixir.ProtoWeb.Endpoint',code_reloader],
                                   error},
                            {proto,['Elixir.ProtoWeb.Endpoint',debug_errors],
                                   error},
                            {proto,['Elixir.ProtoWeb.Endpoint',force_ssl],
                                   error}]},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger,runtime_tools,
                             phoenix,phoenix_ecto,ecto_sql,postgrex,
                             phoenix_html,phoenix_live_view,lazy_html,
                             telemetry_metrics,telemetry_poller,jason,
                             dns_cluster,bandit,probe_support]},
              {description,"proto"},
              {registered,[]},
              {vsn,"0.1.0"},
              {mod,{'Elixir.Proto.Application',[]}}]}.
